#version 460
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer PlanBuffer {
    uint plan_data[];
};
layout(set = 0, binding = 1, std430) buffer WorkspaceBuffer {
    uint workspace_data[];
};
layout(set = 0, binding = 2, std430) buffer CacheBuffer {
    uint cache_data[];
};
layout(push_constant, std430) uniform PushConstants {
    uint value[32];
} pc;

uint load_word(uint selector, uint index) {
    return selector == 0U ? workspace_data[index] : cache_data[index];
}

void store_double(uint selector, uint index, double value) {
    const uvec2 bits = unpackDouble2x32(value);
    if (selector == 0U) {
        workspace_data[index] = bits.x;
        workspace_data[index + 1U] = bits.y;
    } else {
        cache_data[index] = bits.x;
        cache_data[index + 1U] = bits.y;
    }
}

double load_sample(uint linear_index) {
    const uint source_offset = pc.value[2];
    const uint selector = pc.value[4];
    const uint sample_type = pc.value[6];
    if (sample_type == 0U) {
        return double(uintBitsToFloat(
            load_word(selector, source_offset + linear_index)));
    }
    if (sample_type == 3U) {
        const uint word = source_offset + linear_index * 2U;
        return packDouble2x32(uvec2(
            load_word(selector, word), load_word(selector, word + 1U)));
    }

    uint packed;
    uint integer_value;
    if (sample_type == 1U) {
        packed = load_word(selector, source_offset + linear_index / 4U);
        integer_value = (packed >> ((linear_index & 3U) * 8U)) & 0xffU;
    } else {
        packed = load_word(selector, source_offset + linear_index / 2U);
        integer_value = (packed >> ((linear_index & 1U) * 16U)) & 0xffffU;
    }
    return (double(integer_value) - double(uintBitsToFloat(pc.value[7])))
        * double(uintBitsToFloat(pc.value[8]));
}

void main() {
    const uint x = gl_GlobalInvocationID.x;
    const uint y = gl_GlobalInvocationID.y;
    const uint width = pc.value[0];
    const uint height = pc.value[1];
    if (x >= width || y >= height) return;

    const double sample_value = load_sample(y * width + x);
    if (isnan(sample_value) || isinf(sample_value)) {
        atomicOr(workspace_data[pc.value[16]], 1U);
    }
    const uint destination = pc.value[3] + (x * height + y) * 2U;
    store_double(pc.value[5], destination, sample_value);
}
