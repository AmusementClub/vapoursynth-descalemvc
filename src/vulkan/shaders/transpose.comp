#version 460

#ifndef DSMVC_LOCAL_X
#define DSMVC_LOCAL_X 32
#endif
#ifndef DSMVC_LOCAL_Y
#define DSMVC_LOCAL_Y 8
#endif

layout(local_size_x = DSMVC_LOCAL_X, local_size_y = DSMVC_LOCAL_Y,
       local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer PlanBuffer {
    uint plan_data[];
};
layout(set = 0, binding = 1, std430) buffer WorkspaceBuffer {
    uint workspace_data[];
};
layout(set = 0, binding = 2, std430) buffer CacheBuffer {
    uint cache_data[];
};
layout(push_constant, std430) uniform PushConstants {
    uint value[32];
} pc;

uint load_word(uint selector, uint index) {
    return selector == 0U ? workspace_data[index] : cache_data[index];
}

void store_word(uint selector, uint index, uint value) {
    if (selector == 0U) {
        workspace_data[index] = value;
    } else {
        cache_data[index] = value;
    }
}

float load_sample(uint linear_index) {
    const uint source_offset = pc.value[2];
    const uint selector = pc.value[4];
    const uint sample_type = pc.value[6];
    if (sample_type == 0U) {
        return uintBitsToFloat(load_word(selector, source_offset + linear_index));
    }

    uint packed;
    uint integer_value;
    if (sample_type == 1U) {
        packed = load_word(selector, source_offset + linear_index / 4U);
        integer_value = (packed >> ((linear_index & 3U) * 8U)) & 0xffU;
    } else {
        packed = load_word(selector, source_offset + linear_index / 2U);
        integer_value = (packed >> ((linear_index & 1U) * 16U)) & 0xffffU;
    }
    return (float(integer_value) - uintBitsToFloat(pc.value[7]))
        * uintBitsToFloat(pc.value[8]);
}

void main() {
    const uint x = gl_GlobalInvocationID.x;
    const uint y = gl_GlobalInvocationID.y;
    const uint width = pc.value[0];
    const uint height = pc.value[1];
    if (x >= width || y >= height) {
        return;
    }

    const float sample_value = load_sample(y * width + x);
    const uint destination = pc.value[3] + x * height + y;
    store_word(pc.value[5], destination, floatBitsToUint(sample_value));
}
