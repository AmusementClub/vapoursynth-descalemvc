#version 460

#ifndef DSMVC_FIXED_BANDWIDTH
#define DSMVC_FIXED_BANDWIDTH 0
#endif
#if DSMVC_FIXED_BANDWIDTH > 0
#extension GL_EXT_control_flow_attributes : require
#endif

#ifndef DSMVC_LOCAL_SIZE
#define DSMVC_LOCAL_SIZE 32
#endif
#ifndef DSMVC_SOLVE_ONLY
#define DSMVC_SOLVE_ONLY 0
#endif
layout(local_size_x = DSMVC_LOCAL_SIZE, local_size_y = 1,
       local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly restrict buffer PlanBuffer {
    uint plan_data[];
};
layout(set = 0, binding = 1, std430) restrict buffer WorkspaceBuffer {
    uint workspace_data[];
};
layout(set = 0, binding = 2, std430) readonly restrict buffer CacheBuffer {
    uint cache_data[];
};
layout(push_constant, std430) uniform PushConstants {
    uint value[32];
} pc;

float source_value(uint vector, uint index) {
    uint linear;
    if (pc.value[7] == 0U) {
        linear = pc.value[4] + index * pc.value[3] + vector;
    } else {
        linear = pc.value[4] + vector * pc.value[0] + index;
    }
    const uint bits = pc.value[6] == 0U
        ? workspace_data[linear] : cache_data[linear];
    return uintBitsToFloat(bits);
}

uint output_index(uint vector, uint index) {
    if (pc.value[8] == 0U) {
        return pc.value[5] + index * pc.value[3] + vector;
    }
    return pc.value[5] + vector * pc.value[1] + index;
}

float output_value(uint vector, uint index) {
    return uintBitsToFloat(workspace_data[output_index(vector, index)]);
}

void store_output(uint vector, uint index, float result) {
    workspace_data[output_index(vector, index)] = floatBitsToUint(result);
}

#if !DSMVC_SOLVE_ONLY && DSMVC_LOCAL_SIZE == 32 && \
    (DSMVC_FIXED_BANDWIDTH == 5 || DSMVC_FIXED_BANDWIDTH == 7 || \
     DSMVC_FIXED_BANDWIDTH == 11)
#define DSMVC_SPECIALIZE_RHS 1
// Keep one ascending FMA chain. Only the common sparse counts are unrolled;
// clipped borders and every other support retain the original traversal.
#define DSMVC_DEFINE_RHS_COUNT(Count) \
float rhs_count_##Count(uint vector, uint begin) { \
    float sum = 0.0; \
    [[unroll]] \
    for (uint offset = 0U; offset < Count; ++offset) { \
        const uint position = begin + offset; \
        const uint source = plan_data[pc.value[10] + position]; \
        sum = fma(uintBitsToFloat(plan_data[pc.value[11] + position]), \
                  source_value(vector, source), sum); \
    } \
    return sum; \
}
DSMVC_DEFINE_RHS_COUNT(6)
DSMVC_DEFINE_RHS_COUNT(7)
DSMVC_DEFINE_RHS_COUNT(9)
DSMVC_DEFINE_RHS_COUNT(10)
DSMVC_DEFINE_RHS_COUNT(13)
DSMVC_DEFINE_RHS_COUNT(14)
#undef DSMVC_DEFINE_RHS_COUNT

float ordered_rhs(uint vector, uint begin, uint end, uint bandwidth) {
    const uint count = end - begin;
    if (bandwidth == 5U) {
        if (count == 6U) return rhs_count_6(vector, begin);
        if (count == 7U) return rhs_count_7(vector, begin);
    } else if (bandwidth == 7U) {
        if (count == 9U) return rhs_count_9(vector, begin);
        if (count == 10U) return rhs_count_10(vector, begin);
    } else if (bandwidth == 11U) {
        if (count == 13U) return rhs_count_13(vector, begin);
        if (count == 14U) return rhs_count_14(vector, begin);
    }
    float sum = 0.0;
    for (uint position = begin; position < end; ++position) {
        const uint source = plan_data[pc.value[10] + position];
        sum = fma(uintBitsToFloat(plan_data[pc.value[11] + position]),
                  source_value(vector, source), sum);
    }
    return sum;
}
#endif

void inverse_axis_generic(uint vector, uint bandwidth) {
    const uint size = pc.value[1];
    for (uint index = 0U; index < size; ++index) {
#if DSMVC_SOLVE_ONLY
        float sum = output_value(vector, index);
#else
        float sum = 0.0;
        const uint begin = plan_data[pc.value[9] + index];
        const uint end = plan_data[pc.value[9] + index + 1U];
        for (uint position = begin; position < end; ++position) {
            const uint source = plan_data[pc.value[10] + position];
            sum = fma(
                uintBitsToFloat(plan_data[pc.value[11] + position]),
                source_value(vector, source), sum);
        }
#endif
        const uint available = min(bandwidth, index);
        for (uint distance = available; distance > 0U; --distance) {
            sum = fma(
                -uintBitsToFloat(plan_data[
                    pc.value[12] + (distance - 1U) * size + index]),
                output_value(vector, index - distance), sum);
        }
        store_output(
            vector, index,
            sum * uintBitsToFloat(plan_data[pc.value[14] + index]));
    }

    if (size < 2U) {
        return;
    }
    for (uint reverse = size - 1U; reverse > 0U; --reverse) {
        const uint index = reverse - 1U;
        const uint available = min(bandwidth, size - index - 1U);
        float sum = 0.0;
        if (bandwidth == 3U) {
            for (uint distance = 1U; distance <= available; ++distance) {
                sum = fma(
                    uintBitsToFloat(plan_data[
                        pc.value[13] + (distance - 1U) * size + index]),
                    output_value(vector, index + distance), sum);
            }
        } else {
            for (uint distance = available; distance > 0U; --distance) {
                sum = fma(
                    uintBitsToFloat(plan_data[
                        pc.value[13] + (distance - 1U) * size + index]),
                    output_value(vector, index + distance), sum);
            }
        }
        store_output(vector, index, output_value(vector, index) - sum);
    }
}

#if DSMVC_FIXED_BANDWIDTH > 0
void inverse_axis_fixed(uint vector) {
    const uint size = pc.value[1];
    float recent[DSMVC_FIXED_BANDWIDTH];
    [[unroll]]
    for (uint distance = 0U; distance < DSMVC_FIXED_BANDWIDTH; ++distance) {
        recent[distance] = 0.0;
    }

    for (uint index = 0U; index < size; ++index) {
#if DSMVC_SOLVE_ONLY
        float sum = output_value(vector, index);
#else
#ifndef DSMVC_SPECIALIZE_RHS
        float sum = 0.0;
#endif
        const uint begin = plan_data[pc.value[9] + index];
        const uint end = plan_data[pc.value[9] + index + 1U];
#ifdef DSMVC_SPECIALIZE_RHS
        float sum = ordered_rhs(vector, begin, end, uint(DSMVC_FIXED_BANDWIDTH));
#else
        for (uint position = begin; position < end; ++position) {
            const uint source = plan_data[pc.value[10] + position];
            sum = fma(
                uintBitsToFloat(plan_data[pc.value[11] + position]),
                source_value(vector, source), sum);
        }
#endif
#endif
        const uint available = min(uint(DSMVC_FIXED_BANDWIDTH), index);
        [[unroll]]
        for (uint distance = DSMVC_FIXED_BANDWIDTH;
             distance > 0U; --distance) {
            if (distance <= available) {
                sum = fma(
                    -uintBitsToFloat(plan_data[
                        pc.value[12] + (distance - 1U) * size + index]),
                    recent[distance - 1U], sum);
            }
        }
        const float current =
            sum * uintBitsToFloat(plan_data[pc.value[14] + index]);
        store_output(vector, index, current);
        [[unroll]]
        for (uint distance = DSMVC_FIXED_BANDWIDTH - 1U;
             distance > 0U; --distance) {
            recent[distance] = recent[distance - 1U];
        }
        recent[0] = current;
    }

    if (size < 2U) {
        return;
    }
    recent[0] = output_value(vector, size - 1U);
    [[unroll]]
    for (uint distance = 1U; distance < DSMVC_FIXED_BANDWIDTH; ++distance) {
        recent[distance] = 0.0;
    }
    for (uint reverse = size - 1U; reverse > 0U; --reverse) {
        const uint index = reverse - 1U;
        const uint available = min(
            uint(DSMVC_FIXED_BANDWIDTH), size - index - 1U);
        float sum = 0.0;
#if DSMVC_FIXED_BANDWIDTH == 3
        [[unroll]]
        for (uint distance = 1U;
             distance <= DSMVC_FIXED_BANDWIDTH; ++distance) {
            if (distance <= available) {
                sum = fma(
                    uintBitsToFloat(plan_data[
                        pc.value[13] + (distance - 1U) * size + index]),
                    recent[distance - 1U], sum);
            }
        }
#else
        [[unroll]]
        for (uint distance = DSMVC_FIXED_BANDWIDTH;
             distance > 0U; --distance) {
            if (distance <= available) {
                sum = fma(
                    uintBitsToFloat(plan_data[
                        pc.value[13] + (distance - 1U) * size + index]),
                    recent[distance - 1U], sum);
            }
        }
#endif
        const float current = output_value(vector, index) - sum;
        store_output(vector, index, current);
        [[unroll]]
        for (uint distance = DSMVC_FIXED_BANDWIDTH - 1U;
             distance > 0U; --distance) {
            recent[distance] = recent[distance - 1U];
        }
        recent[0] = current;
    }
}
#endif

void main() {
    const uint vector = gl_GlobalInvocationID.x;
    if (vector >= pc.value[3]) {
        return;
    }
#if DSMVC_FIXED_BANDWIDTH > 0
    inverse_axis_fixed(vector);
#else
    const uint bandwidth = pc.value[2];
    if (bandwidth == 1U) {
        inverse_axis_generic(vector, 1U);
    } else if (bandwidth == 3U) {
        inverse_axis_generic(vector, 3U);
    } else if (bandwidth == 5U) {
        inverse_axis_generic(vector, 5U);
    } else if (bandwidth == 7U) {
        inverse_axis_generic(vector, 7U);
    } else {
        inverse_axis_generic(vector, bandwidth);
    }
#endif
}
